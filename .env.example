# Copy to .env and fill in. Never commit real secrets.

# Canonical public origin (no trailing slash). Must not be localhost in production.
SERVER_URL=http://localhost:3000

DATABASE_URL=postgres://portfolio:portfolio@127.0.0.1:5433/portfolio
# Long random string, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=

# Private S3-compatible object storage (MinIO locally)
S3_BUCKET=portfolio-media
S3_ENDPOINT=http://127.0.0.1:9100
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=portfolio
S3_SECRET_ACCESS_KEY=portfolio-secret
S3_FORCE_PATH_STYLE=true

# Transactional email for password reset. When SMTP_HOST is empty in development,
# Payload logs emails to the console instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Vincent Siauw Portfolio

# One-time admin bootstrap for `pnpm create-admin` (refuses to run if any user exists)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
